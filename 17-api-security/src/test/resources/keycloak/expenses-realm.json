{
  "realm": "expenses",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "EMPLOYEE",
        "description": "Files and submits their own expense reports"
      },
      {
        "name": "MANAGER",
        "description": "Approves expense reports for the teams they manage"
      }
    ]
  },
  "clients": [
    {
      "clientId": "expense-tests",
      "name": "Test harness — audience expense-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "expense-tests-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "expense-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "expense-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "partner-tests",
      "name": "A different API's client — audience partner-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "partner-tests-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "protocolMappers": [
        {
          "name": "partner-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "partner-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "expiring-tests",
      "name": "Test harness — access tokens live for one second",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "expiring-tests-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "access.token.lifespan": "1"
      },
      "protocolMappers": [
        {
          "name": "expense-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "expense-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Nguyen",
      "credentials": [
        {
          "type": "password",
          "value": "alice-pw",
          "temporary": false
        }
      ],
